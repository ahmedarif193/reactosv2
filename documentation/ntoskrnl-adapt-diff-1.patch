-        /* Insert at head for immediate scheduling */
-        InsertHeadList(ReadyListHead, &Thread->WaitListEntry);
-    }
-    else
-    {
-        /* Insert at tail for round-robin fairness */
-        InsertTailList(ReadyListHead, &Thread->WaitListEntry);
-    }
